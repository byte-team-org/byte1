# Bot settings
BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=-100xxxxxxxxx

# Database
DATABASE_URL=postgresql+asyncpg://byte_user:byte_pass@localhost:5432/byte_db

# Card number (16 digits, shown to participants)
CARD_NUMBER=1234567890123456
CARD_HOLDER=ISKANDER CF

# Admin panel
SECRET_KEY=change-me-to-random-string-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Region limits (participants / volunteers)
NUKUS_LIMIT_P=50
NUKUS_LIMIT_V=10
NAVOI_LIMIT_P=50
NAVOI_LIMIT_V=10
TASHKENT_LIMIT_P=100
TASHKENT_LIMIT_V=20
KASHKADARYA_LIMIT_P=50
KASHKADARYA_LIMIT_V=10
FERGANA_LIMIT_P=50
FERGANA_LIMIT_V=10
SAMARKAND_LIMIT_P=50
SAMARKAND_LIMIT_V=10
